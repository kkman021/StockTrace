# PostgreSQL
POSTGRES_DB=etf_radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg://radar:changeme@db:5432/etf_radar

# Redis (Celery broker + result backend)
REDIS_URL=redis://redis:6379/0

# Web container exposed port
WEB_PORT=8080

# Internal URL for worker → web admin endpoints
WEB_URL=http://web:8000

# Default thresholds (loaded into system_config on first boot)
DEFAULT_BREADTH_THRESHOLD=0.6
DEFAULT_DEPTH_THRESHOLD=0.6
DEFAULT_CONSECUTIVE_DAYS=3
DEFAULT_SLIDING_WINDOW=5
DEFAULT_REDUCTION_BREADTH_THRESHOLD=0.6
DEFAULT_REDUCTION_CONSECUTIVE_DAYS=3
